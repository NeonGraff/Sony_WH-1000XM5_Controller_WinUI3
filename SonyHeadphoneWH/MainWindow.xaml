<Window
    x:Class="SonyHeadphoneWH.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SonyHeadphoneWH.Converters"
    xmlns:services="using:SonyHeadphoneWH.Services"
    mc:Ignorable="d"
    Title="Sony Headphones Controller">

    <Grid RowDefinitions="*,Auto" Margin="20,16,20,16">
        <Grid.Resources>
            <services:LocalizationSource x:Key="Loc" />

            <!-- 共通カードスタイル -->
            <Style x:Key="CardPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="CardHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

        </Grid.Resources>

        <!-- メインエリア (コンテンツ ＆ ログオーバーレイ) -->
        <Grid Grid.Row="0">
            <!-- メインダッシュボード (ScrollViewer により画面縮小時や高DPI環境でも崩れずスクロール可能) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0">
                <Grid ColumnDefinitions="320,*" ColumnSpacing="16" Margin="0,0,0,4">

                    <!-- 左カラム: デバイスビジュアル ＆ バッテリー ＆ ステータス -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <!-- デバイス画像プレート -->
                            <Border Grid.Row="0"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    CornerRadius="6"
                                    Height="195"
                                    HorizontalAlignment="Stretch"
                                    Padding="10"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <!-- 微妙なアンビエントサークル背景 -->
                                    <Ellipse Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                <GradientStop Color="#18000000" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <Image Source="ms-appx:///Assets/SONY_WH1000XM5.png"
                                           Stretch="Uniform"
                                           MaxHeight="170"
                                           MaxWidth="170"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="{x:Bind ViewModel.DeviceImageOpacity, Mode=OneWay}" />
                                </Grid>
                            </Border>

                    <!-- デバイス名 & 接続バッジ -->
                    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,16">
                        <TextBlock Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- 接続状態ピルバッジ -->
                            <Border Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Visibility="{x:Bind ViewModel.ConnectedVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="SeaGreen" />
                                    <TextBlock Text="{x:Bind ViewModel.Strings.Connected, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Visibility="{x:Bind ViewModel.NotConnectedVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="Gray" />
                                    <TextBlock Text="{x:Bind ViewModel.Strings.Disconnected, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{x:Bind ViewModel.SelectedDevice.MacAddress, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- バッテリーセクション -->
                    <Border Grid.Row="2"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind ViewModel.BatteryGlyph, Mode=OneWay}"
                                              FontSize="20"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Strings.BatteryLevel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Background="LightGreen"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        Visibility="{x:Bind ViewModel.ChargingVisibility, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.Strings.Charging, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="DarkGreen" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.BatteryLevel, Mode=OneWay}" FontSize="28" FontWeight="Bold" />
                                <TextBlock Text="%" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ProgressBar Value="{x:Bind ViewModel.BatteryLevel, Mode=OneWay}"
                                         Maximum="100"
                                         Height="6"
                                         CornerRadius="3" />
                        </StackPanel>
                    </Border>

                    <!-- デバイス情報 ＆ オーディオ機能 (ファームウェア ＆ コーデック ＆ DSEE) -->
                    <Border Grid.Row="3"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="14,12">
                        <StackPanel Spacing="10">
                            <!-- ファームウェアバージョン表示 (シンプルなテキスト表記) -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Strings.FirmwareLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind ViewModel.FirmwareVersion, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <MenuFlyoutSeparator Margin="0" />

                            <!-- コーデック表示 (シンプルなテキスト表記) -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Strings.CodecLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind ViewModel.CodecName, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <MenuFlyoutSeparator Margin="0" />

                            <!-- DSEE アップスケーリング (操作可能なスイッチ) -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEC15;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.DseeDisplayName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.DseeStatusText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2"
                                              IsOn="{x:Bind ViewModel.IsDseeEnabled, Mode=OneWay}"
                                              IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                              Toggled="OnDseeToggled"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右カラム: デバイス接続・操作セクション ＆ タブ切り替え & パネル -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

                <!-- 1. デバイス選択・接続操作セクション (ヘッダーから移動) -->
                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                        <!-- デバイス選択コンボボックス -->
                        <ComboBox ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                                  DisplayMemberPath="ModelName"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="{x:Bind ViewModel.Strings.DeviceSelectPlaceholder, Mode=OneWay}"
                                  IsEnabled="{x:Bind ViewModel.IsNotConnected, Mode=OneWay}" />

                        <!-- 再検索 / 更新ボタン -->
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.RefreshOrScanCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Strings.RefreshDevicesTooltip, Mode=OneWay}">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>

                        <!-- 接続 / 切断ボタン -->
                        <Button Grid.Column="2"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Bind ViewModel.Strings.Connect, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ConnectCommand}"
                                Visibility="{x:Bind ViewModel.NotConnectedVisibility, Mode=OneWay}" />

                        <Button Grid.Column="2"
                                Content="{x:Bind ViewModel.Strings.Disconnect, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DisconnectCommand}"
                                Visibility="{x:Bind ViewModel.ConnectedVisibility, Mode=OneWay}" />

                        <!-- 電源オフボタン -->
                        <Button Grid.Column="3"
                                Command="{x:Bind ViewModel.PowerOffCommand}"
                                IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Strings.PowerOffTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7E8;" FontSize="13" Foreground="IndianRed" />
                                <TextBlock Text="{x:Bind ViewModel.Strings.PowerOff, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <!-- 言語切替ボタン (JA / EN) -->
                        <Button Grid.Column="4"
                                Command="{x:Bind ViewModel.ToggleLanguageCommand}"
                                ToolTipService.ToolTip="Switch Language / 言語切り替え">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE774;" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.Strings.LanguageButtonText, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. 上部タブセレクター (SelectorBar による Fluent モダンタブデザイン) -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <SelectorBar x:Name="TabSelectorBar"
                                     HorizontalAlignment="Left"
                                     SelectionChanged="OnSelectorBarSelectionChanged">
                            <SelectorBarItem x:Name="SoundTabItem" Text="{x:Bind ViewModel.Strings.SoundControlTab, Mode=OneWay}">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="DeviceTabItem" Text="{x:Bind ViewModel.Strings.ConnectedDevicesTab, Mode=OneWay}">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE8EA;" FontSize="14" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                        </SelectorBar>

                        <!-- 接続中台数バッジ (タブ1選択時に台数が一目でわかる) -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                CornerRadius="10"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.DeviceTabVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Strings.ConnectedPrefix, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectedDevicesCount, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Strings.UnitDevices, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- タブ 0: サウンド・メディアコントロール -->
                <Grid Grid.Row="2"
                      RowDefinitions="Auto,Auto,*"
                      RowSpacing="14"
                      Visibility="{x:Bind ViewModel.SoundTabVisibility, Mode=OneWay}">

                    <!-- 1. 外音コントロール (ノイズキャンセリング / 外音取り込み / オフ) -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="{x:Bind ViewModel.Strings.AmbientSoundControl, Mode=OneWay}" Style="{StaticResource CardHeaderTextStyle}" Margin="0" />
                            </Grid>

                            <!-- モード選択 RadioButtons (横並び) -->
                            <RadioButtons Grid.Row="1"
                                          SelectedIndex="{x:Bind ViewModel.SelectedNoiseControlModeIndex, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                          SelectionChanged="OnNoiseModeSelectionChanged"
                                          MaxColumns="3"
                                          Margin="0,0,0,6">
                                <RadioButton Content="{x:Bind ViewModel.Strings.NoiseCancelling, Mode=OneWay}" />
                                <RadioButton Content="{x:Bind ViewModel.Strings.AmbientSound, Mode=OneWay}" />
                                <RadioButton Content="{x:Bind ViewModel.Strings.Off, Mode=OneWay}" />
                            </RadioButtons>

                            <!-- 外音取り込みレベル & ボイスフォーカス (外音取り込み時のみ表示) -->
                            <Border Grid.Row="2"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,8,0,0"
                                    Visibility="{x:Bind ViewModel.AmbientSoundVisibility, Mode=OneWay}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="{x:Bind ViewModel.Strings.AmbientLevelLabel, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                        <Slider Grid.Column="1"
                                                Minimum="1" Maximum="20" StepFrequency="1"
                                                Value="{x:Bind ViewModel.AmbientSoundLevel, Mode=TwoWay}"
                                                Margin="14,0,14,0"
                                                ValueChanged="OnAmbientLevelValueChanged"
                                                PointerCaptureLost="OnAmbientSliderPointerReleased"
                                                PointerReleased="OnAmbientSliderPointerReleased" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.AmbientSoundLevel, Mode=OneWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Width="24" TextAlignment="Right" />
                                    </Grid>

                                    <ToggleSwitch Header="{x:Bind ViewModel.Strings.VoiceFocusHeader, Mode=OneWay}"
                                                  IsOn="{x:Bind ViewModel.VoiceFocus, Mode=TwoWay}"
                                                  Toggled="OnVoiceFocusToggled"
                                                  FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 2. 音量コントロール -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{x:Bind ViewModel.Strings.HeadphoneVolume, Mode=OneWay}" Style="{StaticResource CardHeaderTextStyle}" Margin="0" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.VolumeDownCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Strings.VolumeDownTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE993;" FontSize="14" />
                                </Button>

                                <Slider Grid.Column="1"
                                        Minimum="0" Maximum="30" StepFrequency="1"
                                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                        ValueChanged="OnVolumeSliderValueChanged"
                                        PointerCaptureLost="OnVolumeSliderPointerReleased"
                                        PointerReleased="OnVolumeSliderPointerReleased" />

                                <Button Grid.Column="2"
                                        Command="{x:Bind ViewModel.VolumeUpCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Strings.VolumeUpTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE995;" FontSize="14" />
                                </Button>

                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind ViewModel.Volume, Mode=OneWay}"
                                           FontWeight="Bold" FontSize="18"
                                           Width="32" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 3. 再生中のメディア (Now Playing) -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0">
                                <TextBlock Text="{x:Bind ViewModel.Strings.NowPlaying, Mode=OneWay}" Style="{StaticResource CardHeaderTextStyle}" />
                                <Button HorizontalAlignment="Right"
                                        Command="{x:Bind ViewModel.RefreshTrackCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Strings.RefreshTrackTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                </Button>
                            </Grid>

                            <!-- トラック情報 -->
                            <Grid Grid.Row="1" Margin="0,4,0,12" ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalAlignment="Center">
                                <Border Width="60" Height="60" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="10">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}"
                                               FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.TrackArtist, Mode=OneWay}"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.TrackAlbum, Mode=OneWay}"
                                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <!-- 再生操作ボタン群 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                <Button Command="{x:Bind ViewModel.PreviousTrackCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                        Width="48" Height="40"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Strings.PreviousTrackTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                                </Button>

                                <Button Command="{x:Bind ViewModel.PlayPauseCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Width="60" Height="40"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Strings.PlayPauseTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind ViewModel.PlayPauseIconGlyph, Mode=OneWay}" FontSize="18" />
                                </Button>

                                <Button Command="{x:Bind ViewModel.NextTrackCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                        Width="48" Height="40"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Strings.NextTrackTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- タブ 1: 接続デバイス & マルチポイント管理 -->
                <Border Grid.Row="2"
                        Style="{StaticResource CardPanelStyle}"
                        Visibility="{x:Bind ViewModel.DeviceTabVisibility, Mode=OneWay}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <!-- ヘッダー -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.Strings.MultipointHeaderTitle, Mode=OneWay}" Style="{StaticResource CardHeaderTextStyle}" Margin="0" />
                                <TextBlock Text="{x:Bind ViewModel.Strings.MultipointHeaderSubtitle, Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.RefreshPairedDevicesCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.Strings.RefreshPairedDevicesTooltip, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.Strings.RefreshPairedDevicesButton, Mode=OneWay}" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <MenuFlyoutSeparator Grid.Row="1" Margin="0,0,0,12" />

                        <!-- マルチポイント無効時の案内バナー -->
                        <InfoBar Grid.Row="2"
                                 IsOpen="{x:Bind ViewModel.IsMultipointDisabled, Mode=OneWay}"
                                 Severity="Warning"
                                 IsClosable="False"
                                 Title="{x:Bind ViewModel.Strings.MultipointDisabledTitle, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.Strings.MultipointDisabledMessage, Mode=OneWay}"
                                 Margin="0,0,0,12" />

                        <!-- デバイスリスト -->
                        <ListView Grid.Row="3"
                                  ItemsSource="{x:Bind ViewModel.HeadphonePairedDevices, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.PairedDevicesListVisibility, Mode=OneWay}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,4,0,4">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <!-- カテゴリアイコン -->
                                            <Border Width="40" Height="40"
                                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="{Binding Glyph}" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- デバイス名 & MAC & バッジ -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="14" />

                                                    <!-- 接続中ピル -->
                                                    <Border Background="LightGreen"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding Strings.Connected, Source={StaticResource Loc}}" FontSize="10" FontWeight="Bold" Foreground="DarkGreen" />
                                                    </Border>

                                                    <!-- 音声再生中ピル -->
                                                    <Border Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Visibility="{Binding IsPlaybackDevice, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding Strings.AudioOutputBadge, Source={StaticResource Loc}}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding MacAddress}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <!-- 操作ボタン群 -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <!-- 未接続の場合: 接続ボタン -->
                                                <Button Content="{Binding Strings.Connect, Source={StaticResource Loc}}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Padding="12,4"
                                                        FontSize="12"
                                                        Click="OnConnectPairedDeviceClick"
                                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityInvertedConverter}}" />

                                                <!-- 接続中の場合: 音声切替ボタン -->
                                                <Button Content="{Binding Strings.SwitchAudioButton, Source={StaticResource Loc}}"
                                                        Padding="10,4"
                                                        FontSize="12"
                                                        ToolTipService.ToolTip="{Binding Strings.SwitchAudioTooltip, Source={StaticResource Loc}}"
                                                        Click="OnSwitchAudioSourceClick"
                                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <!-- 接続中の場合: 切断ボタン -->
                                                <Button Content="{Binding Strings.Disconnect, Source={StaticResource Loc}}"
                                                        Padding="10,4"
                                                        FontSize="12"
                                                        Click="OnDisconnectPairedDeviceClick"
                                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <!-- 削除 / ペアリング解除ボタン -->
                                                <Button Padding="8,4"
                                                        ToolTipService.ToolTip="{Binding Strings.UnpairTooltip, Source={StaticResource Loc}}"
                                                        Click="OnUnpairDeviceClick">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="IndianRed" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 未接続またはマルチポイント機器が0件の場合の空状態表示 -->
                        <StackPanel Grid.Row="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,36,0,36"
                                    Spacing="12"
                                    Visibility="{x:Bind ViewModel.EmptyPairedDevicesVisibility, Mode=OneWay}">
                            <Border Width="64" Height="64" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="32" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8EA;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.Strings.EmptyDevicesTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Strings.EmptyDevicesSubtitle, Mode=OneWay}" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>

            <!-- ログオーバーレイパネル (メインコンテンツの上に浮遊して被さり、他のUIを一切押し上げない) -->
            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Height="240"
                    Margin="0,0,0,4"
                    Canvas.ZIndex="100"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    Visibility="{x:Bind ViewModel.LogVisibility, Mode=OneWay}">
                <Grid RowDefinitions="Auto,*">
                    <!-- ログヘッダー -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Strings.LogPanelTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.LogHistory.Count, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ClearLogsCommand}" Padding="8,3" FontSize="11" ToolTipService.ToolTip="{x:Bind ViewModel.Strings.ClearLogsTooltip, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                    <TextBlock Text="{x:Bind ViewModel.Strings.ClearLogsButton, Mode=OneWay}" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.CloseLogCommand}" Padding="8,3" ToolTipService.ToolTip="{x:Bind ViewModel.Strings.CloseLogTooltip, Mode=OneWay}">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ログリスト -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.LogHistory}"
                              SelectionMode="None"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="6,4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,1" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- 常駐ステータスバー (常に最下部にスッキリ固定配置) -->
        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="14,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{x:Bind ViewModel.ConnectionBadgeText, Mode=OneWay}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ToggleButton Grid.Column="3"
                              IsChecked="{x:Bind ViewModel.IsLogOpen, Mode=TwoWay}"
                              Padding="10,4"
                              FontSize="11"
                              ToolTipService.ToolTip="{x:Bind ViewModel.Strings.LogHistoryTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE756;" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.Strings.LogHistoryButton, Mode=OneWay}" FontSize="11" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</Window>
